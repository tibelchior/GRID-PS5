+++ b/tools/scripts/merge_pipelines.py	2026-11-19 23:18:16
@@ -65,8 +65,10 @@
     data = open(path, "rb").read()
     (n,) = struct.unpack_from("<H", data, 4)
     off, keys = 6 + n, set()
-    while off < len(data):
+    while off + 2 <= len(data):
         (n,) = struct.unpack_from("<H", data, off)
+        if off + 2 + n + options_size + 8 + 4 + 24 > len(data):
+            break  # an entry cut short when the title was ended: the cache is kept up to here
         name = data[off + 2:off + 2 + n]
         off += 2 + n
         info = data[off:off + options_size + 8]
