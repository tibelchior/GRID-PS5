+// The title's log keeps only errors: DXVK and runtime lines with "err"/"fail"/..., and the whole of a
+// crash or fatal report (its register and stack lines follow it). An empty file named "verbose" in the
+// data folder keeps everything, as before.
+bool g_log_all = false;
+void log_errors_only(const char* data, size_t size, std::string& out) {
+    static std::string partial;
+    static bool in_report = false;
+    partial.append(data, size);
+    size_t from = 0;
+    for (size_t nl; (nl = partial.find('\n', from)) != std::string::npos; from = nl + 1) {
+        const std::string line = partial.substr(from, nl - from);
+        bool keep = false;
+        if (line.find("CRASH") != std::string::npos || line.find("crash at") != std::string::npos ||
+            line.find("FATAL") != std::string::npos || line.find("quitting (") != std::string::npos ||
+            line.find("ExitProcess(") != std::string::npos) {
+            in_report = keep = true;
+        } else if (in_report && (line.empty() || line[0] == ' ' || line.rfind("[rt]", 0) == 0)) {
+            keep = true;
+        } else {
+            in_report = false;
+            std::string low = line;
+            for (char& ch : low) ch = char(std::tolower(static_cast<unsigned char>(ch)));
+            for (const char* word : {"error", "err:", "fail", "cannot", "not implemented", "unimplemented", "abort", "invalid", "game folder"})
+                if (low.find(word) != std::string::npos) {
+                    keep = true;
+                    break;
+                }
+        }
+        if (keep) {
+            out += line;
+            out += '\n';
+        }
+    }
+    partial.erase(0, from);
+    if (partial.size() > 8192) partial.clear();  // a line that never ends
