+// Commit: backs every unbacked chunk of [addr, addr + size), coalescing runs.
+void os_commit(uint32_t addr, uint32_t size) {
+    if (!size || !g_direct) return;
+    uint32_t c = std::max<uint32_t>(addr & ~(kChunk - 1), kAllocFloor) / kChunk;
+    const uint32_t end = uint32_t(std::min<uint64_t>(kSpace,
+        (uint64_t(addr) + size + kChunk - 1) & ~uint64_t(kChunk - 1)) / kChunk);
+    while (c < end) {
+        if (g_mapped[c]) {
+            ++c;
+            continue;
+        }
+        uint32_t e = c;
+        while (e < end && !g_mapped[e] && e - c < kMaxRun / kChunk) ++e;
+        uint8_t* const at = recomp_mem + uint64_t(c) * kChunk;
+        const size_t n = size_t(e - c) * kChunk;
+        // One direct-memory allocation for the run, mapped over its part of the
+        // reservation. (Not ps5_vrange_commit: the SDK revision PS5_Vulkan pins
+        // does not have it yet.) The mapping is kept for the life of the process.
+        ps5_shm backing{};
+        void* view = nullptr;
+        int rc = ps5_shm_create(n, &backing);
+        const char* stage = "ps5_shm_create";
+        if (!rc) {
+            stage = "ps5_shm_map";
+            rc = ps5_shm_map(&backing, 0, n, at, PS5_SHM_READ | PS5_SHM_WRITE, PS5_SHM_FIXED, &view);
+            if (!rc && view != at) rc = PS5_SHM_NO_PLACE;
+        }
+        if (rc) fatal("guest commit 0x%08X+0x%zX failed in %s: 0x%X (%llu MB backed)", unsigned(c * kChunk), n, stage,
+                      unsigned(rc), (unsigned long long)(g_mapped_bytes >> 20));
+        std::memset(at, 0, n);  // direct memory is handed out as it was released
+        for (uint32_t k = c; k < e; ++k) g_mapped[k] = true;
