+// as on other POSIX hosts.
+constexpr uint32_t kChunk = 0x10000;          // direct-memory unit (allocation granularity)
+constexpr uint32_t kMaxRun = 64 * 1024 * 1024;  // one direct-memory allocation at most
+std::vector<bool> g_mapped(kSpace / kChunk);  // chunk is backed by memory
+uint64_t g_mapped_bytes = 0;
