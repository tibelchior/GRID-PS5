+    for (uint64_t a = addr; a < end;) {
+        const uint64_t next = std::min<uint64_t>((a / kChunk + 1) * kChunk, end);
+        if (g_mapped[a / kChunk]) std::memset(recomp_mem + a, 0, size_t(next - a));
