+std::string g_ps5_data;
+void ps5_mark(const char* what) {
+    static std::string all, target;
+    all += what;
+    all += '\n';
+    const std::string want = !g_ps5_data.empty() ? g_ps5_data : "/app0/data";
+    const bool fresh = want != target;
+    std::error_code ec;
+    if (fresh) std::filesystem::create_directories(want, ec);
+    if (std::FILE* f = std::fopen((want + "/boot.txt").c_str(), fresh ? "w" : "a")) {
+        if (fresh) std::fputs(all.c_str(), f);
+        else std::fprintf(f, "%s\n", what);
+        std::fclose(f);
+        target = want;
+    }
