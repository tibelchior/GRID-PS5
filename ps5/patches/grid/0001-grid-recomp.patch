+// GRID caps the usable resolution with <res mem=".." maxWidth="1280"/> in its restrictions file (a
+// 2009 video-memory budget). Serve a copy with the cap raised so 1440p and above can be selected.
+static void patch_grid_max_width() {
+    const std::string rel = "system/hardware_settings_restrictions.xml";
+    std::string x = read_file(vfs::host_path(std::string(vfs::kInstallDir) + "\\" + rel));
+    const size_t at = x.find("maxWidth=\"1280\"");
+    if (at == std::string::npos) return;
+    x.replace(at, 15, "maxWidth=\"7680\"");
+    const std::string dir = vfs::data_dir() + "/overlay";
+    std::error_code ec;
+    std::filesystem::create_directories(dir, ec);
+    const std::string out = dir + "/hardware_settings_restrictions.xml";
+    if (!write_file(out, x)) return;
+    vfs::set_override(rel, out);
+    rt::log("menu: resolution cap raised to 7680");
+}
+
 void install_menu_patches(bool metalfx_row) {
+    patch_grid_max_width();
     if (!metalfx_row) return;  // the row stays hidden, as the game ships it
     const std::string dir = vfs::data_dir() + "/overlay";
     std::error_code ec;
