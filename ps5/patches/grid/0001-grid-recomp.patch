+        return;
+    }
+    if (t.state == TextEntryDriver::Typing) {
+        // Each key: the message on the first frame, two quiet frames after it.
+        if (t.step >= t.script.size()) {
+            g_injected[0x01].store(0, std::memory_order_relaxed);
