+// ---- On-screen keyboard for GRID's name entry (ScreenOverlayTextEntry / IBTextEntry) ----
+// GRID takes typed text from WM_CHAR messages (its window procedure forwards them to the text
+// input at 0x00EC1DB0). A pad has none, so while a text entry is on screen the console's on-screen
+// keyboard (ps5_console.h) asks for the text, and it is then sent to the game as WM_CHAR messages:
+// Backspace (8) for the old text, the new characters, then Return (13), or Escape (27) when cancelled.
+// f_0049F870 is IBTextEntry's per-frame update (thiscall, this in ecx); it runs once a frame
+// while an entry is up, which is how the start of an entry is noticed (a gap in the calls).
+extern "C" void f_0049F870_orig(X86* c);
+namespace shim {
+void post_message(uint32_t hwnd, uint32_t msg, uint32_t wp, uint32_t lp);
+}
+
+namespace {
+
+struct TextEntryDriver {
+    std::mutex mu;
+    uint32_t active_this = 0;
+    uint32_t last_tick = 0;
+    int calls = 0;  // updates since this entry appeared
+    enum { Idle, Asking, Typing, Finished } state = Idle;
+    std::atomic<bool> answered{false};
+    bool confirmed = false;
+    std::string answer;
+    std::vector<uint16_t> script;  // characters to send
+    bool escape_key = false;       // also press Escape on the keyboard (cancel)
+    size_t step = 0;
+    int phase = 0;
+    int old_len = 0;
+};
+TextEntryDriver g_te;
+
+std::string read_cstr(uint32_t a, size_t limit) {
+    std::string s;
+    for (size_t i = 0; a && i < limit; ++i) {
+        const char ch = char(rd8(a + uint32_t(i)));
+        if (!ch) break;
+        s += ch;
+    }
+    return s;
+}
+
+std::string entry_text(uint32_t self) {
+    const uint32_t obj = rd32(self + 0x18);
+    return obj ? read_cstr(rd32(obj + 0x28), 64) : std::string();
+}
+
+void text_entry_tick(uint32_t self) {
+    TextEntryDriver& t = g_te;
+    const uint32_t now = SDL_GetTicks();
