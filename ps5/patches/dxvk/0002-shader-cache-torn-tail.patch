+  bool DxvkShaderCache::truncateLut(size_t length) {
+    auto path = m_filePaths.directory + env::PlatformDirSlash + m_filePaths.lutFile;
+
+    // The open stream is in a failed state after the short read: use new ones.
+    std::vector<char> prefix(length);
+
+    { util::File reader(path, util::FileFlags(util::FileFlag::AllowRead));
+
+      if (!reader || !reader.read(0u, length, prefix.data()))
+        return false;
+    }
+
+    m_lutFile = util::File();
+
+    { util::File writer(path, util::FileFlags(
+        util::FileFlag::AllowWrite, util::FileFlag::Truncate, util::FileFlag::Exclusive));
+
+      if (!writer || !writer.append(length, prefix.data()) || !writer.flush())
+        return false;
+    }
+
+    return m_lutFile.open(path, util::FileFlags(
+      util::FileFlag::AllowRead, util::FileFlag::AllowWrite, util::FileFlag::Exclusive));
+  }
