+          VkExtent2D          surface,
+          float x, float y, float w, float h,
+          float r, float g, float b, float a) {
+    // The colours are as they should look; an sRGB target encodes them itself
+    if (lookupFormatInfo(key.format)->flags.test(DxvkFormatFlag::ColorSpaceSrgb)) {
+      r = std::pow(r, 2.2f);
+      g = std::pow(g, 2.2f);
+      b = std::pow(b, 2.2f);
+    }
+
+    RectArgs args = { };
+    args.rect[0] = x;
+    args.rect[1] = y;
+    args.rect[2] = w;
+    args.rect[3] = h;
+    args.surface[0] = float(surface.width);
+    args.surface[1] = float(surface.height);
+    args.color[0] = r;
+    args.color[1] = g;
+    args.color[2] = b;
+    args.color[3] = a;
+
+    ctx->cmdBindPipeline(DxvkCmdBuffer::ExecBuffer,
+      VK_PIPELINE_BIND_POINT_GRAPHICS, getPipeline(key));
+
+    ctx->bindResources(DxvkCmdBuffer::ExecBuffer,
+      m_layout, 0u, nullptr, sizeof(args), &args);
+
+    ctx->cmdDraw(4, 1, 0, 0);
+  }
