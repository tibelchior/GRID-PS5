diff -urN a/src/dxvk/hud/shaders/hud_rect_vert.vert b/src/dxvk/hud/shaders/hud_rect_vert.vert
--- a/src/dxvk/hud/shaders/hud_rect_vert.vert
+++ b/src/dxvk/hud/shaders/hud_rect_vert.vert
@@ -0,0 +1,16 @@
+#version 450
+
+// A filled rectangle (the on-screen keyboard's panel and keys): a triangle strip of four corners.
+layout(push_constant)
+uniform rect_info_t {
+  vec4 rect;      // x, y, width, height in pixels
+  vec2 surface;   // the target's size in pixels
+  vec2 padding;
+  vec4 color;     // red, green, blue, alpha
+};
+
+void main() {
+  vec2 corner = vec2(float(gl_VertexIndex & 1), float((gl_VertexIndex >> 1) & 1));
+  vec2 position = rect.xy + corner * rect.zw;
+  gl_Position = vec4(position / surface * 2.0f - 1.0f, 0.0f, 1.0f);
+}
