+
+
+  HudPos HudKeyboardItem::render(
+    const Rc<DxvkCommandList>&ctx,
+    const HudPipelineKey&     key,
+    const HudOptions&         options,
+          HudRenderer&        renderer,
+          HudPos              position) {
+    char buffer[1024];
+    int length = dirt3_ps5_keyboard_text(buffer, sizeof(buffer));
+
+    if (length <= 0)
+      return position;
+
+    // One line per row, at a fixed place: the first line is the title
+    std::string text(buffer, size_t(length));
+    HudPos at = { 640, 360 };
+    size_t start = 0;
+    bool first = true;
+
+    while (start <= text.size()) {
+      size_t end = text.find('\n', start);
+
+      if (end == std::string::npos)
+        end = text.size();
+
+      renderer.drawText(first ? 32 : 28, at, first ? 0xffffe060u : 0xffffffffu, text.substr(start, end - start));
+      at.y += first ? 44 : 38;
+      first = false;
+      start = end + 1;
+    }
+
+    return position;
   }
 
 
