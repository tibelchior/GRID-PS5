+extern "C" int dirt3_ps5_keyboard_text(char* out, int capacity);
+extern "C" bool dirt3_ps5_hud_enabled();
+
 namespace dxvk::hud {
 
   HudItem::~HudItem() {
@@ -83,8 +87,48 @@
             HudRenderer&        renderer) {
     HudPos position = { 8, 8 };
 
-    for (const auto& item : m_items)
+    const bool statistics = dirt3_ps5_hud_enabled();
+
+    for (const auto& item : m_items) {
+      if (!statistics && !item->isKeyboard())
+        continue;
+
       position = item->render(ctx, key, options, renderer, position);
+    }
