# Exact revisions the build uses. Change them only after a full build has been tested.
# The recompilation tree is the DiRT 3 source tree: build.sh mounts it read-only from DIRT3_SRC (default:
# ../dirt3-recomp-src next to this folder) and the container applies ps5/patches/grid and ps5/patches/dirt3.
DXVK_REPO=https://github.com/doitsujin/dxvk.git
DXVK_COMMIT=b1a1c99ab52b687cf950d62c88bc2fa316b41663
PS5_VULKAN_REPO=https://github.com/mihawk-99/PS5_Vulkan.git
PS5_VULKAN_COMMIT=7f492b4c6f67a4e8c8c67a4272cfeef22abea9cc
PS5_PAYLOADSDK_REPO=https://github.com/mihawk-99/PS5_PayloadSDK.git
PS5_PAYLOADSDK_COMMIT=3345cde7441f2d5f5432dd6d4f494cacbc974e28
PS5_MESA_REPO=https://github.com/mihawk-99/PS5_Mesa.git
PS5_MESA_COMMIT=0f86253f674c425052948eb3cb116c81e646a734
# The game: Race Driver GRID, PC (GOG). GRID.exe is UPX-packed; the recompiler fits the UNPACKED exe
# (grid_game.exe, `upx -d GRID.exe`), whose hash is below.
GAME_EXE_SHA256=954e9dca446b7822c969063f79f4f2212f7defc8756c212508479271d2a286ec
TITLE_ID=PPSA99779
